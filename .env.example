# ---------------------------------------------------------------------------
# The Local Edit — content + SEO configuration
#
#   cp .env.example .env
#   npm run generate        # writes drafts
#   npm run review          # approve them
#
# Everything here is read on the server only (generator + admin panel) and
# baked into content/site.json. No secret ever reaches the browser.
#
# PER-LANGUAGE KEYS: any CONTENT_*, SITE_*, RSS_*, or CTA_* key can be
# suffixed with a language code — CONTENT_KEYWORDS_ID overrides
# CONTENT_KEYWORDS for Indonesian. Unsuffixed keys apply to every language.
# ---------------------------------------------------------------------------

# === Languages =============================================================

# Comma separated. The FIRST is the default: "/" redirects to it, and it is
# the x-default in hreflang. Each gets its own URL prefix (/id, /en), its own
# article set, its own feeds, and its own keywords.
SITE_LANGUAGES=id,en
SITE_DEFAULT_LANGUAGE=id

# Labels shown in the header language switcher.
SITE_LANGUAGE_LABEL_ID=Bahasa Indonesia
SITE_LANGUAGE_LABEL_EN=English

# === Site identity (shared) ================================================

# The public origin. MUST be the real domain — canonical URLs, hreflang,
# sitemap.xml, and structured data are all built from it. No trailing slash.
SITE_URL=https://journal.localbalivillas.com

SITE_NAME=The Local Edit

# Organisation behind the site (JSON-LD Organization / Publisher).
BRAND_NAME=Local Bali Villas
BRAND_URL=https://localbalivillas.com
BRAND_LOGO=/favicon.svg

# Twitter/X handle for twitter:site card meta. Leave blank to omit.
TWITTER_HANDLE=

# === Indonesian ============================================================

SITE_TAGLINE_ID=oleh Local Bali Villas
SITE_EDITION_ID=Catatan Bali · 2026
SITE_DESCRIPTION_ID=Panduan villa, kawasan, dan ritme sehari-hari di Bali — ditulis untuk pelancong yang ingin merasa seperti di rumah sendiri.

CONTENT_TOPIC_ID=Memilih dan memesan villa di Bali — kawasan, saran perjalanan praktis, dan rekomendasi lokal
CONTENT_AUDIENCE_ID=Pelancong yang merencanakan liburan 1–3 minggu di Bali: pasangan, keluarga, dan rombongan kecil
CONTENT_TONE_ID=Hangat, tepat, bergaya editorial. Praktis, bukan promosi. Tidak berlebihan, bukan listicle.
CONTENT_AUTHOR_NAME_ID=Made Sari
CONTENT_AUTHOR_ROLE_ID=Editor perjalanan Bali

# Each article is assigned one focus keyword from this list, working through
# unused terms first. Head terms like "sewa villa bali" are extremely
# competitive — the long tail below is where a local operator actually wins.
CONTENT_KEYWORDS_ID=villa untuk keluarga di bali, villa dengan kolam renang pribadi di bali, daerah terbaik untuk menginap di bali, villa ubud, villa canggu, biaya tersembunyi sewa villa di bali, sewa villa bali
CONTENT_LONGTAIL_ID=cara memilih villa di bali, tips sewa villa di bali, lebih baik menginap di ubud atau canggu, apa saja yang harus ditanyakan sebelum memesan villa di bali, berapa lama sebelumnya harus booking villa di bali

# Indonesian-language feeds. All four were checked and are live.
#   bali.antaranews.com — ANTARA Bali · travel.detik.com — detikTravel
#   nusabali.com — NusaBali · rss.tempo.co — Tempo Travel
RSS_FEEDS_ID=https://bali.antaranews.com/rss/terkini.xml,https://travel.detik.com/rss,https://www.nusabali.com/rss,https://rss.tempo.co/travel
RSS_REQUIRE_TERMS_ID=bali,villa,vila,ubud,canggu,seminyak,uluwatu,wisata,penginapan,liburan,pariwisata

CTA_LABEL_ID=Rujukan lokal pilihan
CTA_TITLE_ID=Jelajahi villa Bali pilihan
CTA_DESCRIPTION_ID=Lihat penginapan lokal dan bicara dengan tim yang berbasis di Bali untuk menemukan yang paling cocok untuk perjalananmu.

# === English ===============================================================

SITE_TAGLINE_EN=by Local Bali Villas
SITE_EDITION_EN=Bali notes · 2026
SITE_DESCRIPTION_EN=Considered guides to Bali's villas, neighbourhoods, and everyday rituals — written for travellers who want to feel at home.

CONTENT_TOPIC_EN=Choosing and booking villas in Bali — neighbourhoods, practical travel advice, and local recommendations
CONTENT_AUDIENCE_EN=International travellers planning a 1–3 week trip to Bali, including couples, families, and small groups
CONTENT_TONE_EN=Warm, precise, editorial. Practical over promotional. Never hypey, never listicle-filler.
CONTENT_AUTHOR_NAME_EN=Made Sari
CONTENT_AUTHOR_ROLE_EN=Bali travel editor

CONTENT_KEYWORDS_EN=bali villa for families, private pool villa bali, best area to stay in bali, ubud villa, canggu villa, hidden costs of renting a bali villa, bali villa rental
CONTENT_LONGTAIL_EN=how to choose a villa in bali, bali villa booking tips, is it better to stay in ubud or canggu, what to ask before booking a bali villa, how far in advance to book a bali villa

RSS_FEEDS_EN=https://www.thebalisun.com/feed/,https://coconuts.co/bali/feed/
RSS_REQUIRE_TERMS_EN=bali,villa,ubud,canggu,seminyak,uluwatu,travel

CTA_LABEL_EN=Recommended local resource
CTA_TITLE_EN=Explore handpicked Bali villas
CTA_DESCRIPTION_EN=Browse local stays and speak with a Bali-based team about the right fit for your trip.

# === Shared conversion target ==============================================

CTA_HREF=https://localbalivillas.com

# === How drafts are produced ===============================================

# ai      — Claude writes original articles from the topic + keywords above.
# rss     — Publish feed excerpts with attribution. Cheap, but syndicated
#           content does not rank; treat it as a digest, not an SEO channel.
# hybrid  — Feeds supply topical signal, Claude writes an ORIGINAL article.
#           Recommended. Feeds may be in any language; output follows the
#           target language.
CONTENT_SOURCE=hybrid

# How many drafts to create per language per run.
CONTENT_ARTICLES_PER_RUN=1

# Hard cap on the published index per language. 0 = unlimited.
CONTENT_MAX_ARTICLES=0

# Words per article. 1500–2500 suits competitive terms.
CONTENT_WORD_COUNT=2000

# Only consider feed items newer than this many days. 0 = no limit.
RSS_MAX_AGE_DAYS=30

# === Claude ================================================================

# Get one at https://console.anthropic.com/. Never commit this (.env is
# gitignored). If unset, the generator writes clearly-marked placeholder
# drafts so you can exercise the review panel and the build without a key.
ANTHROPIC_API_KEY=

# Cost per article is dominated by output tokens, and thinking is most of the
# output. Measured cost is printed after every run.
#   claude-sonnet-5  $3/$15 per MTok  ($2/$10 introductory through 2026-08-31)
#   claude-opus-5    $5/$25 per MTok  — best quality, use for cornerstone pages
# effort: low | medium | high | xhigh | max
CONTENT_MODEL=claude-sonnet-5
CONTENT_EFFORT=medium

# === Images ================================================================

# Comma separated pool of hero image URLs, assigned round-robin.
# Use images you have the rights to. These Unsplash URLs are examples —
# replace them with your own villa photography, which is also better for SEO.
CONTENT_IMAGE_POOL=https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&fit=crop&w=2000&q=88,https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=2000&q=88,https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&w=2000&q=88,https://images.unsplash.com/photo-1573790387438-4da905039392?auto=format&fit=crop&w=2000&q=88

# === Crawling ==============================================================

# false on staging: emits noindex everywhere and a blanket robots.txt Disallow.
SEO_INDEXABLE=true

# Adds noindex to pages built from RSS excerpts only (CONTENT_SOURCE=rss).
# Turn this on if syndicated pages ever draw a duplicate-content penalty.
RSS_ITEM_NOINDEX=false

# === Admin review panel ====================================================

ADMIN_PORT=4100

# Generate with `npm run admin:password` and paste the output here.
# Never store the plaintext password in this file.
ADMIN_PASSWORD_HASH=

# Random string used to sign the admin session cookie.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Command the panel runs after publishing, to rebuild and reload the site.
# Leave blank to publish without rebuilding (useful in development).
ADMIN_PUBLISH_COMMAND=
